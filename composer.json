{
    "name": "mrthito/laravel-google-merchant-api",
    "description": "Laravel Google Merchant Products API for Google Shopping.",
    "homepage": "https://github.com/mrthito/laravel-google-merchant-api",
    "license": "MIT",
    "authors": [
        {
            "name": "rashant Rijal",
            "email": "prashant@mrthito.com",
            "role": "Developer"
        }
    ],
    "keywords":[
        "Laravel",
        "Google Merchant API",
        "Google Shopping API",
        "mrthito.com"
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/support": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "MrThito\\GoogleMerchantApi\\": "src"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "MrThito\\GoogleMerchantApi\\GoogleMerchantApiServiceProvider"
            ],
            "aliases": {
                "ProductsApi": "MrThito\\GoogleMerchantApi\\Facades\\ProductsApi"
            }
        }
    }
}
